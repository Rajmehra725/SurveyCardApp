{
  "expo": {
    "name": "SmileyX",
    "slug": "SurveyCardApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Icon.png",
    "scheme": "smileyx",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/Icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to your camera to capture profile photos and moments.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select photos, videos, and profile images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.raazchat.pro"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SmileyX to access your photos.",
          "cameraPermission": "Allow SmileyX to access your camera."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "android": {
            "image": "./assets/images/splash.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa30c3de-0f64-4eb8-b3a9-b5d4f37cdb6c"
      }
    },
    "owner": "rajmehra001"
  }
}
